# Copy to .env.local and fill in (both Supabase values are public by design;
# row level security protects the data).
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Where the web build (dashboard + bio page) is hosted, e.g. https://affiliate.pages.dev
EXPO_PUBLIC_SITE_URL=

# Optional: custom short-link domain that proxies to the `go` function.
EXPO_PUBLIC_SHORT_LINK_BASE=
